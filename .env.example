# ==============================================================================
# GoChina Environment Variables — Copy to .env.local (or set in Vercel / Cloudflare)
# ==============================================================================

# 1. Your production domain (NO trailing slash). Used for canonical URLs, sitemap.xml, robots.txt & Open Graph.
NEXT_PUBLIC_SITE_URL=https://china.tmhzz.com

# 2. Public contact email shown on About / Contact / Privacy pages (required for Google AdSense review).
NEXT_PUBLIC_CONTACT_EMAIL=hello@tmhzz.com

# 3. Google Search Console HTML-tag verification code (the value inside content="..." ONLY).
NEXT_PUBLIC_GSC_VERIFICATION=

# 4. Bing Webmaster Tools verification code (optional).
NEXT_PUBLIC_BING_VERIFICATION=

# 5. Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable GA4.
NEXT_PUBLIC_GA_ID=

# 6. Google AdSense Publisher ID (e.g. ca-pub-1234567890123456).
#    Also remember to update public/ads.txt with the same pub-ID!
NEXT_PUBLIC_ADSENSE_CLIENT=

# 7. Optional Google AdSense manual ad unit slot IDs (Auto ads still work if these are left empty).
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
